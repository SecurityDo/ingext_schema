{
    "name": "Netskope",
    "description": "Netskope Security Cloud alerts and events imported by the Netskope plugin via REST API v2 dataexport: DLP alerts (alerts/dlp), DLP incidents (events/incident) and Endpoint DLP (events/epdlp) by default, plus any other alert/event type enabled on the integration. The Netskope record is under '@netskope'; labels.eventType names the stream (NetskopeDlpAlert, NetskopeIncident, NetskopeEndpointDlp, ...).",
    "dynamic": true,
    "rootField": "@netskope",
    "aliases": [
        {
            "name": "@behaviors",
            "value": "_behaviors"
        },
        {
            "name": "@customer",
            "value": "_customer"
        }
    ],
    "fields": [
        {
            "name": "timestamp",
            "fpltype": "int64",
            "type": "INT64",
            "convertedtype": "TIMESTAMP_MILLIS"
        },
        {
            "name": "size",
            "fpltype": "int64",
            "type": "INT32"
        },
        {
            "name": "doc",
            "fpltype": "string",
            "type": "BYTE_ARRAY",
            "convertedtype": "UTF8",
            "logical_hint": "kusto_dynamic_json"
        },
        {
            "name": "labels",
            "fpltype": "map",
            "type": "MAP",
            "nullable": true,
            "fields": [
                {
                    "name": "key",
                    "fpltype": "string",
                    "type": "BYTE_ARRAY",
                    "convertedtype": "UTF8"
                },
                {
                    "name": "value",
                    "fpltype": "string",
                    "type": "BYTE_ARRAY",
                    "convertedtype": "UTF8"
                }
            ]
        }
    ]
}
